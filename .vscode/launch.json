{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "zabob-houdini (run function in houdini_functions, with args)",
            "type": "debugpy",
            "request": "launch",
            "python": "hython",
            "module": "zabob_houdini",
            "args": [
                "_exec",
                "houdini_functions",
                "_run_with_more",
                "${input:additionalArgs}"
            ]
        },
        {
            "name": "Debug Houdini Test Function",
            "type": "debugpy",
            "request": "launch",
            "module": "zabob_houdini",
            "args": [
                "houdini",
                "run-test",
                "${input:Test Function Name}"
            ],
            "python": "hython",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "Generate Test List"
        },
        {
            "name": "Debug Houdini Example",
            "type": "debugpy",
            "request": "launch",
            "module": "zabob_houdini",
            "args": [
                "_examples",
                "_run-example",
                "${input:Example File Name}"
            ],
            "python": "hython",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "envFile": "${workspaceFolder}/.env",
            "console": "integratedTerminal",
            "justMyCode": true,
            "preLaunchTask": "Generate Example List"
        },
        {
            "name": "Hython Debugger: Current File",
            "type": "debugpy",
            "python": "hython",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "Test Function Name",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "key": "testFunction",
                "description": "Select test function to run",
                "default": "__escape__",
                "fileName": "${workspaceFolder}/.vscode/tmp/test-functions.txt"
            }
        },
        {
            "id": "Example File Name",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "key": "exampleFile",
                "description": "Select example file to run",
                "default": "__escape__",
                "fileName": "${workspaceFolder}/.vscode/tmp/example-files.txt"
            }
        },
        {
            "id": "additionalArgs",
            "type": "promptString",
            "description": "Additional arguments (e.g. --verbose --save)",
            "default": ""
        }
    ]
}
