{
	"version": "2.0.0",
	"tasks": [
        {
            "type": "npm",
            "script": "list-hython-tests",
            "problemMatcher": [],
            "label": "npm: list-hython-tests"
        },
        {
            "label": "Generate Test List",
            "type": "shell",
            "command": "npm run list-hython-tests 2>/dev/null | grep -E '^(test_|\\._exit)' > .vscode/tmp/test-functions.txt",
            "group": "build",
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Generate Example List",
            "type": "shell",
            "command": "npm run list-examples 2>/dev/null | grep -v '^>' > .vscode/tmp/example-files.txt",
            "group": "build",
            "presentation": {
                "echo": false,
                "reveal": "never",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": false
            }
        },
        {
            "label": "Run Houdini Example (Save HIP)",
            "type": "shell",
            "command": "zabob-houdini run ${workspaceFolder}/examples/${input:exampleFile}.py --save",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "dependsOn": ["Generate Example List"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "exampleFile",
            "type": "command",
            "command": "extension.commandvariable.pickStringRemember",
            "args": {
                "key": "exampleFile",
                "description": "Select example file to run",
                "default": "._exit",
                "fileName": "${workspaceFolder}/.vscode/tmp/example-files.txt",
                "pattern": {
                    "regexp": "^(.+)$",
                    "label": "$1",
                    "value": "$1"
                }
            }
        }
    ]
}
