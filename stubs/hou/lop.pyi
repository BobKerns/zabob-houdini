# ============================================================================
# Node Parameters and USD Properties
# ============================================================================

def createParmsForProperty(
    source: Any,
    primpath: str,
    propertyname: str,
    parametername: str,
    prepend_control_parm: bool,
    prefix_xform_parms: bool,
) -> hou.ParmTemplateGroup:
    """
    Given a property on a USD stage, this method returns a hou.ParmTemplateGroup
    object that describes the parameters that can be placed on an Edit Properties LOP
    node to control that USD property.

    Args:
        source: The source USD stage or node
        primpath: The primitive path
        propertyname: The property name
        parametername: The parameter name to create
        prepend_control_parm: Whether to prepend a control parameter
        prefix_xform_parms: Whether to prefix transform parameters

    Returns:
        A parameter template group
    """
    ...

def createParmsForParameter(
    source: Any,
    parametername: str,
    usdvaluetype: str,
    prepend_control_parm: bool,
    propertyname: str,
) -> hou.ParmTemplateGroup:
    """
    Given a source node parameter, this method returns a hou.ParmTemplateGroup
    object that describes the parameters that can be placed on an Edit Properties LOP
    node to control a value of a corresponding USD property.

    Args:
        source: The source node
        parametername: The parameter name
        usdvaluetype: The USD value type
        prepend_control_parm: Whether to prepend a control parameter
        propertyname: The USD property name

    Returns:
        A parameter template group
    """
    ...

def createConnectionParmsForProperty(
    source: Any,
    primpath: str,
    propertyname: str,
    parametername: str | None = None,
    prepend_control_parm: bool = True,
) -> hou.ParmTemplateGroup:
    """
    Given a property on a USD stage, this method returns a hou.ParmTemplateGroup
    object that describes the parameters that can be placed on an Edit Properties LOP
    node to modify the connection of that USD (destination) property to a source
    attribute.

    Args:
        source: The source USD stage or node
        primpath: The primitive path
        propertyname: The property name
        parametername: Optional parameter name to create
        prepend_control_parm: Whether to prepend a control parameter

    Returns:
        A parameter template group
    """
    ...

def setParmTupleFromProperty(
    parmtuple: hou.ParmTuple,
    source: Any,
    primpath: str,
    propertyname: str,
) -> None:
    """
    Set the value of a node parameter tuple from the value of a property on a USD
    primitive.

    Args:
        parmtuple: The parameter tuple to set
        source: The source USD stage or node
        primpath: The primitive path
        propertyname: The property name
    """
    ...

