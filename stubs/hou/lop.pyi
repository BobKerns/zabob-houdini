def translateShader(
    node: hou.Node,
    node_output_name: str,
    material_prim_path: str,
    container_prim_path: str,
    shader_prim_name: str | None = None,
    frame: float | None = None,
) -> str:
    """
    Creates a new shader primitive and returns a path to the shader primitive output.

    Args:
        node: The shader node to translate
        node_output_name: The output name on the node
        material_prim_path: The USD path for the material primitive
        container_prim_path: The USD path for the container primitive
        shader_prim_name: Optional name for the shader primitive
        frame: Optional frame time for evaluation

    Returns:
        The path to the shader primitive output
    """
    ...

def reportShaderTranslation(node: hou.Node, usd_shader_path: str) -> None:
    """
    Adds an entry to the table of known shader translations.

