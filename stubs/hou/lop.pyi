"""
LOP module for Houdini USD/Solaris workflow utilities.

This module provides functions for working with USD stages, preferences,
shader translation, parameters, render delegates, and output processors.

See: https://www.sidefx.com/docs/houdini/hom/hou/lop.html
"""

from typing import Any

import hou

